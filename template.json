    "z620": "$CONNECT host=z620 alias=CONNECT_Z620",
    "vultr": "$CONNECT host=vultr alias=CONNECT_VULTR"
  },
  "workstation": {
    "time_utc": "$DATE",
    "uname": "$UNAME",
    "dns": "$DNS",
